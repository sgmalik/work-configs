            "old_text": "func loadConfig() (*appconfig.Store[Config], *Config, error) {\nstore := appconfig.New[Config](\"sarge\")\ncfg, err := store.Load()\nif err != nil {\nreturn store, nil, fmt.Errorf(\"load config %s: %w\", store.Path(), err)\n}\nif cfg.TasksDoc == \"\" {\ncfg.TasksDoc = \"~/repos/projects.md\"\n_ = store.Save(cfg)\n}\nif len(cfg.WatchRoots) == 0 {\nreturn store, cfg, fmt.Errorf(\"config %s has no watch_roots configured; at least one existing directory is required\", store.Path())\n}\nresolvedRoots, err := validateWatchRoots(cfg.WatchRoots)\nif err != nil {\nreturn store, cfg, err\n}\ncfg.WatchRoots = resolvedRoots\nreturn store, cfg, nil\n}",
            "new_text": "func loadConfig() (*appconfig.Store[Config], *Config, error) {\nstore := appconfig.New[Config](\"sarge\")\n_, statErr := os.Stat(store.Path())\nfileExisted := statErr == nil\ncfg, err := store.Load()\nif err != nil {\nreturn store, nil, fmt.Errorf(\"load config %s: %w\", store.Path(), err)\n}\nif cfg.TasksDoc == \"\" {\ncfg.TasksDoc = \"~/repos/projects.md\"\n_ = store.Save(cfg)\n}\n// On first-ever config creation, persist safe defaults for the git\n// safety flags so a fresh install behaves as documented (\"usually\n// TRUE\") instead of silently running unguarded. A bool field can't\n// distinguish \"absent from file\" from \"explicitly false\" once loaded,\n// so this only fires when the config file itself didn't exist yet.\nif !fileExisted {\ncfg.RequireCleanDir = true\ncfg.RequireCleanTests = true\ncfg.GitRollbackOnFail = true\n_ = store.Save(cfg)\n}\nif len(cfg.WatchRoots) == 0 {\nreturn store, cfg, fmt.Errorf(\"config %s has no watch_roots configured; at least one existing directory is required\", store.Path())\n}\nresolvedRoots, err := validateWatchRoots(cfg.WatchRoots)\nif err != nil {\nreturn store, cfg, err\n}\ncfg.WatchRoots = resolvedRoots\n\n// Wire the loaded config into the runtime flags that actually gate\n// worker/precheck behavior; previously these package vars were\n// hardcoded and the yaml fields were read into Config but never used.\nrequireCleanDir = cfg.RequireCleanDir\ncreateGitBranch = cfg.CreateGitBranch\nrequireCleanTests = cfg.RequireCleanTests\ngitRollbackOnFail = cfg.GitRollbackOnFail\n\nreturn store, cfg, nil\n}"
          }
        ]
      }
    ]
  },
