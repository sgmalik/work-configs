chRoots)\n+\n+\tworkDir, err := filepath.Abs(*dirFlag)\n+\tif err != nil {\n+\t\tfmt.Fprintf(os.Stderr, \"invalid working directory %s: %v\\n\", *dirFlag, err)\n+\t\tos.Exit(1)\n+\t}\n+\n+\tdb, err := openDB(*dbFlag)\n+\tif err != nil {\n+\t\tlogger.Error(\"open db\", \"path\", *dbFlag, \"err\", err)\n+\t\tfmt.Fprintf(os.Stderr, \"failed to open database %s: %v\\n\", *dbFlag, err)\n+\t\tos.Exit(1)\n+\t}\n+\tdefer db.Close()\n+\tosFs := afero.NewOsFs()\n+\n+\t// Ingest plan if present\n+\tplanPath := filepath.Join(workDir, *planFlag)\n+\tif _, err := os.Stat(planPath); err == nil {\n+\t\tparsedTasks, parseErr := parsePlanFile(planPath)\n+\t\tif parseErr != nil {\n+\t\t\tlogger.Error(\"parse plan\", \"path\", planPath, \"err\", parseErr)\n+\t\t} else if len(parsedTasks) \u003e 0 {\n+\t\t\tif err := upsertParsedTasks(db, parsedTasks); err != nil {\n+\t\t\t\tlogger.Error(\"upsert parsed tasks\", \"err\", err)\n+\t\t\t} else {\n+\t\t\t\tlogger.Log(\"ingested plan\", \"count\", len(parsedTasks))\n+\t\t\t}\n+\t\t}\n+\t}\n+\n+\t// Ingest sarge_inbox tasks across all configured watch roots\n+\tfor _, root := range cfg.WatchRoots {\n+\t\tabsRoot, err := filepath.Abs(root)\n+\t\tif err != nil {\n+\t\t\tabsRoot = root\n+\t\t}\n+\t\tif inboxTasks, err := scanInboxDirs(osFs, absRoot); err == nil \u0026\u0026 len(inboxTasks) \u003e 0 {\n+\t\t\tif err := upsertParsedTasks(db, inboxTasks); err != nil {\n+\t\t\t\tlogger.Error(\"upsert inbox tasks\", \"root\", absRoot, \"err\", err)\n+\t\t\t} else {\n+\t\t\t\tlogger.Log(\"ingested sarge_inbox tasks\", \"root\", absRoot, \"count\", len(inboxTasks))\n+\t\t\t}\n+\t\t}\n+\t}\n+\n+\tctx, cancel := context.WithCancel(context.Background())\n+\n+\tdiscoverer := NewDiscoverer()\n+\tprechecker := NewPreChecker(nil, 30*time.Second, 500*time.Millisecond, logger)\n+\n+\t// Validate sarge_model directives in the umbrella doc before starting.\n+\tumbrellaPath := effectiveUmbrellaPath(cfg)\n+\tif umbrellaPath != \"\" {\n+\t\tif _, statErr := os.Stat(