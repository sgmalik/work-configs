      "diff": "--- a//Users/sm-syc/Sycamore/Tools/apps/sarge/config.go\n+++ b//Users/sm-syc/Sycamore/Tools/apps/sarge/config.go\n@@ -1 +1,123 @@\n+package main\n \n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\n+\t\"github.com/Sycamore/Tools/shared/appconfig\"\n+)\n+\n+// Defaults here only matter for tests that exercise the worker/precheck\n+// logic directly; main() overwrites these from Config on every real run.\n+var (\n+\trequireCleanDir   = false\n+\tcreateGitBranch   = false\n+\trequireCleanTests = false\n+\tgitRollbackOnFail = false\n+)\n+\n+type Config struct {\n+\tWatchRoots           []string `yaml:\"watch_roots\"`\n+\tTasksDoc             string   `yaml:\"tasks_doc\"`\n+\tShowPiOutput         bool     `yaml:\"show_pi_output\"`\n+\tRequireCleanDir      bool     `yaml:\"require_clean_dir\"`\n+\tCreateGitBranch      bool     `yaml:\"create_git_branch\"`\n+\tRequireCleanTests    bool     `yaml:\"require_clean_tests\"`\n+\tGitRollbackOnFail    bool     `yaml:\"git_rollback_on_fail\"`\n+\tAutoLaunchLogsViewer bool     `yaml:\"auto_launch_logs_viewer\"`\n+\tHideStartupNotice    bool     `yaml:\"hide_startup_notice\"`\n+}\n+\n+// effectiveUmbrellaPath returns the configured tasks_doc path (expanded),\n+// falling back to DefaultUmbrellaPath when the field is unset.\n+func effectiveUmbrellaPath(cfg *Config) string {\n+\tif cfg != nil \u0026\u0026 cfg.TasksDoc != \"\" {\n+\t\tp, err := expandPath(cfg.TasksDoc)\n+\t\tif err == nil {\n+\t\t\treturn p\n+\t\t}\n+\t}\n+\treturn DefaultUmbrellaPath()\n+}\n+\n+func expandPath(p string) (string, error) {\n+\tp = strings.TrimSpace(p)\n+\tif p == \"\" {\n+\t\treturn \"\", errors.New(\"empty path\")\n+\t}\n+\tif p == \"~\" || strings.HasPrefix(p, \"~/\") {\n+\t\thome, err := os.UserHomeDir()\n+\t\tif err != nil {\n+\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n+\t\t}\n+\t\tif p == \"~\" {\n+\t\t\tp = home\n+\t\t} else {\n+\t\t\tp = filepath.Join(home, p[2:])\n+\t\t}\n+\t}\n+\treturn filepath.Abs(p)\n+}\n+\n+func validateWatchRoots(roots []string) ([]string, error) {\n+\tif len(roots) == 0 {\n+\t\treturn nil, errors.New(\"no watch_roots configured in config; at least one existing directory is required\")\n+\t}\n+\tvar resolved []string\n+\tfor _, raw := range roots {\n+\t\tabsPath, err := expandPath(raw)\n+\t\tif err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"invalid watch root %q: %w\", raw, err)\n+\t\t}\n+\t\tfi, err := os.Stat(absPath)\n+\t\tif err != nil {\n+\t\t\tif os.IsNotExist(err) {\n+\t\t\t\treturn nil, fmt.Errorf(\"watch root does not exist: %s (%q)\", absPath, raw)\n+\t\t\t}\n+\t\t\treturn nil, fmt.Errorf(\"cannot access watch root %s: %w\", absPath, err)\n+\t\t}\n+\t\tif !fi.IsDir() {\n+\t\t\treturn nil, fmt.Errorf(\"watch root is not a directory: %s\", absPath)\n+\t\t}\n+\t\tresolved = append(resolved, absPath)\n+\t}\n+\treturn resolved, nil\n+}\n+\n+func loadConfig() (*appconfig.Store[Config], *Config, error) {\n+\tstore := appconfig.New[Config](\"sarge\")\n+\t_, statErr := os.Stat(store.Path())\n+\tfileExisted := statErr == nil\n+\tcfg, err := store.Load()\n+\tif err != nil {\n+\t\treturn store, nil, fmt.Errorf(\"load config %s: %w\", store.Path(), err)\n+\t}\n+\tif cfg.TasksDoc == \"\" {\n+\t\tcfg.TasksDoc = \"~/repos/projects.md\"\n+\t\t_ = store.Save(cfg)\n+\t}\n+\t// On first-ever config creation, persist safe defaults for the git\n+\t// safety flags so a fresh install behaves as documented (\"usually\n+\t// TRUE\") instead of silently running unguarded. A bool field can't\n+\t// distinguish \"absent from file\" from \"explicitly false\" once loaded,\n+\t// so this only fires when the config file itself didn't exist yet.\n+\tif !fileExisted {\n+\t\tcfg.RequireCleanDir = true\n+\t\tcfg.RequireCleanTests = true\n+\t\tcfg.GitRollbackOnFail = true\n+\t\t_ = store.Save(cfg)\n+\t}\n+\tif len(cfg.WatchRoots) == 0 {\n+\t\treturn store, cfg, fmt.Errorf(\"config %s has no watch_roots configured; at least one existing directory is required\", store.Path())\n+\t}\n+\tresolvedRoots, err := validateWatchRoots(cfg.WatchRoots)\n+\tif err != nil {\n+\t\treturn store, cfg, err\n+\t}\n+\tcfg.WatchRoots = resolvedRoots\n+\treturn store, cfg, nil\n+}\n+\n",
