            "old_text": "func (h *SkillHandler) CredibilityPackage(c *gin.Context) {\nif h.credibilityPkg == nil {\nc.JSON(http.StatusServiceUnavailable, gin.H{\"error\": \"Credibility package service not configured\"})\nreturn\n}\n\nversionIDVal, err := strconv.ParseUint(c.Param(\"vid\"), 10, 64)\nif err != nil {\nc.JSON(http.StatusBadRequest, gin.H{\"error\": \"Invalid version ID\"})\nreturn\n}\nversionID := uint(versionIDVal)\n\nzipData, filename, err := h.credibilityPkg.Generate(c.Request.Context(), versionID)\nif err != nil {\nh.log.Ctx(c.Request.Context()).WithError(err).WithField(\"version_id\", versionID).Error(\"Failed to generate credibility package\")\nc.JSON(http.StatusInternalServerError, gin.H{\"error\": fmt.Sprintf(\"Failed to generate package: %v\", err)})\nreturn\n}\n\nc.Header(\"Content-Type\", \"application/zip\")\nc.Header(\"Content-Disposition\", fmt.Sprintf(\"attachment; filename=%q\", filename))\nc.Data(http.StatusOK, \"application/zip\", zipData)\n}",
            "new_text": "func (h *SkillHandler) CredibilityPackage(c *gin.Context) {\nif h.credibilityPkg == nil {\nc.JSON(http.StatusServiceUnavailable, gin.H{\"error\": \"Credibility package service not configured\"})\nreturn\n}\n\nversionIDVal, err := strconv.ParseUint(c.Param(\"vid\"), 10, 64)\nif err != nil {\nc.JSON(http.StatusBadRequest, gin.H{\"error\": \"Invalid version ID\"})\nreturn\n}\nversionID := uint(versionIDVal)\n\nsv, _ := h.repo.FindVersionByID(versionID)\nvar skillName string\nvar versionNum int\nif sv != nil {\nversionNum = sv.Version\nif skill, err := h.repo.FindByID(sv.SkillID); err == nil \u0026\u0026 skill != nil {\nskillName = skill.Name\n}\n}\n\nzipData, filename, err := h.credibilityPkg.Generate(c.Request.Context(), versionID)\nif err != nil {\nh.log.Ctx(c.Request.Context()).WithError(err).WithField(\"version_id\", versionID).Error(\"Failed to generate credibility package\")\nif h.auditSvc != nil {\nh.auditSvc.LogError(c, \"credibility.export\", \"skill\", fmt.Sprintf(\"Failed to export credibility package for '%s' v%d\", skillName, versionNum), err)\n}\nc.JSON(http.StatusInternalServerError, gin.H{\"error\": fmt.Sprintf(\"Failed to generate package: %v\", err)})\nreturn\n}\n\nif h.auditSvc != nil {\nbaselineID := \"\"\nif sv != nil {\nif baseline, err := h.repo.FindLatestVersionBefore(sv.SkillID, sv.Version); err == nil \u0026\u0026 baseline != nil {\nbaselineID = fmt.Sprintf(\"%d\", baseline.ID)\n}\n}\nh.auditSvc.LogWithEntity(c, \"credibility.export\", \"skill\", \"skill_version\", fmt.Sprintf(\"%d\", versionID),\nfmt.Sprintf(\"Exported credibility package for '%s' v%d as %s (baseline_version_id=%s)\", skillName, versionNum, filename, baselineID))\n}\n\nc.Header(\"Content-Type\", \"application/zip\")\nc.Header(\"Content-Disposition\", fmt.Sprintf(\"attachment; filename=%q\", filename))\nc.Data(http.StatusOK, \"application/zip\", zipData)\n}"
          }
        ]
      }
    ]
  },
