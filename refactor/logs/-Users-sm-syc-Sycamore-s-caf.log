            "old_text": "func TestInputPII_Off_PassThrough(t *testing.T) {\nres := runInputPII(t, `{\"input_pii_mode\":\"off\"}`, \"patient SSN is 123-45-6789\")\nif !res.Passed {\nt.Fatal(\"mode=off must be a pass-through even with PII present\")\n}\n}",
            "new_text": "func TestInputPII_Off_PassThrough(t *testing.T) {\n// off-mode never disables the rail; it detects at warn severity (does not block).\nres := runInputPII(t, `{\"input_pii_mode\":\"off\"}`, \"patient SSN is 123-45-6789\")\nif res.Passed {\nt.Fatal(\"off-mode should detect PII (Passed=false)\")\n}\nif res.Severity != SeverityWarn {\nt.Errorf(\"off-mode should warn, got %s\", res.Severity)\n}\n}"
          },
          {
            "old_text": "{\"mixed-case off\", `{\"input_pii_mode\":\"OFF\"}`, true, SeverityWarn},\n{\"disabled alias\", `{\"input_pii_mode\":\"disabled\"}`, true, SeverityWarn},\n{\"none alias\", `{\"input_pii_mode\":\"none\"}`, true, SeverityWarn},",
            "new_text": "{\"mixed-case off\", `{\"input_pii_mode\":\"OFF\"}`, false, SeverityWarn},\n{\"disabled alias\", `{\"input_pii_mode\":\"disabled\"}`, false, SeverityWarn},\n{\"none alias\", `{\"input_pii_mode\":\"none\"}`, false, SeverityWarn},"
          },
          {
            "old_text": "// off mode → pipeline passes with no warnings, even with PII present\noffAgent := \u0026models.Agent{Guardrails: models.JSON(`{\"input_pii_mode\":\"off\"}`)}\nres = newPipe().RunPhase(context.Background(), PhasePre, \u0026GuardrailCheckInput{Agent: offAgent, EventPayload: payload})\nif !res.Passed {\nt.Fatal(\"off-mode must not fail the pipeline\")\n}\nif len(res.Warnings) != 0 {\nt.Errorf(\"off-mode should surface no warnings, got %v\", res.Warnings)\n}",
            "new_text": "// off mode → pipeline passes but surfaces a warning (never disables the rail)\noffAgent := \u0026models.Agent{Guardrails: models.JSON(`{\"input_pii_mode\":\"off\"}`)}\nres = newPipe().RunPhase(context.Background(), PhasePre, \u0026GuardrailCheckInput{Agent: offAgent, EventPayload: payload})\nif !res.Passed {\nt.Fatal(\"off-mode must not fail the pipeline\")\n}\nif len(res.Warnings) == 0 {\nt.Error(\"off-mode should surface a warning (rail never disabled)\")\n}\nif len(res.Warnings) \u003e 0 {\nif strings.Contains(res.Warnings[0], payload) {\nt.Errorf(\"warning must not contain matched PII values; got: %s\", res.Warnings[0])\n}\n}"
          }
        ]
      }
