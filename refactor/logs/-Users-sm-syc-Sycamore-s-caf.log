            "new_text": "// ReviewEntry is a single review result.\ntype ReviewEntry struct {\nReviewerType  string  `json:\"reviewer_type\"`\nReviewerID    string  `json:\"reviewer_id\"`\nReviewerModel string  `json:\"reviewer_model,omitempty\"`\nLayer         int     `json:\"layer\"`\nStatus        string  `json:\"status\"`\nFindings      any     `json:\"findings,omitempty\"`\nComments      string  `json:\"comments,omitempty\"`\nScore         float64 `json:\"score\"`\nReviewedAt    string  `json:\"reviewed_at\"`\n}\n\n// VersionComparison captures how a skill version differs from its immediate\n// predecessor: quality/pass-rate deltas, per-field content diffs, fixture\n// diffs, and the content/eval hashes of both sides. For a skill's first\n// version (no predecessor exists) it is emitted as an initial-version stub\n// with IsInitialVersion set and no baseline-derived data.\ntype VersionComparison struct {\nSkillVersionID    uint               `json:\"skill_version_id\"`\nBaselineVersionID *uint              `json:\"baseline_version_id,omitempty\"`\nBaselineVersion   *int               `json:\"baseline_version,omitempty\"`\nIsInitialVersion  bool               `json:\"is_initial_version\"`\nQualityDelta      float64            `json:\"quality_delta\"`\nPassRateDelta     float64            `json:\"pass_rate_delta\"`\nFieldDiffs        []VersionFieldDiff `json:\"field_diffs,omitempty\"`\nFixtureDiffs      []FixtureDiffEntry `json:\"fixture_diffs,omitempty\"`\nOldContentHash    string             `json:\"old_content_hash,omitempty\"`\nNewContentHash    string             `json:\"new_content_hash\"`\nOldEvalHash       string             `json:\"old_eval_hash,omitempty\"`\nNewEvalHash       string             `json:\"new_eval_hash\"`\nGeneratedAt       time.Time          `json:\"generated_at\"`\n}"
          }
        ]
