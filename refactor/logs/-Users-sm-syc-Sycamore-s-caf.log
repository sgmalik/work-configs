          {
            "old_text": "// InputPIICheck (ADR-054) scans the prompt/input for PII/PHI during the pre-LLM\n// phase. Unlike the output PHI rail (PhasePost, always block), this input rail is\n// admin-tunable per agent via the Guardrails JSON key \"input_pii_mode\":\n//\n//\toff   → no check\n//\twarn  → flag + record, do not block (DEFAULT)\n//\tblock → fail the execution before the LLM call",
            "new_text": "// InputPIICheck (ADR-054) scans the prompt/input for PII/PHI during the pre-LLM\n// phase. Unlike the output PHI rail (PhasePost, always block), this input rail is\n// admin-tunable per agent via the Guardrails JSON key \"input_pii_mode\":\n//\n//\twarn  → flag + record, do not block (DEFAULT)\n//\tblock → fail the execution before the LLM call\n//\n// The rail is never disabled (off/disabled/none map to warn mode)."
          },
          {
            "old_text": "// Check scans input.EventPayload and sets the result severity from the agent's\n// configured input_pii_mode (default warn). The rail is never disabled; off/disabled/none\n// detect PII at warn severity (detect but do not block).\nfunc (c *InputPIICheck) Check(_ context.Context, input *GuardrailCheckInput) *GuardrailCheckResult {\n\t// inputPIIMode is nil-safe and is called first so result.Severity carries the\n\t// resolved default even for a nil input; the nil/disabled guard follows.\n\tenabled, severity := inputPIIMode(input)\n\tresult := \u0026GuardrailCheckResult{CheckName: c.Name(), Passed: true, Severity: severity}\n\tif input == nil || !enabled {\n\t\treturn result\n\t}",
            "new_text": "// Check scans input.EventPayload and sets the result severity from the agent's\n// configured input_pii_mode (default warn). The rail is never disabled.\nfunc (c *InputPIICheck) Check(_ context.Context, input *GuardrailCheckInput) *GuardrailCheckResult {\n\tseverity := inputPIIMode(input)\n\tresult := \u0026GuardrailCheckResult{CheckName: c.Name(), Passed: true, Severity: severity}\n\tif input == nil {\n\t\treturn result\n\t}"
          },
          {
            "old_text": "// inputPIIMode resolves whether the input PII rail is enabled and at what severity,\n// from the agent's Guardrails JSON (\"input_pii_mode\": off|warn|block). Default warn.\n// The rail is never disabled; off/disabled/none map to enabled+SeverityWarn (detect but do not block).\nfunc inputPIIMode(input *GuardrailCheckInput) (enabled bool, severity GuardrailSeverity) {",
            "new_text": "// inputPIIMode resolves the severity for the input PII rail from the agent's\n// Guardrails JSON (\"input_pii_mode\": warn|block). Default warn.\n// The rail is never disabled; off/disabled/none map to SeverityWarn (detect but do not block).\nfunc inputPIIMode(input *GuardrailCheckInput) GuardrailSeverity {"
          },
          {
            "old_text": "\tswitch mode {\n\tcase \"off\", \"disabled\", \"none\":\n\t\treturn true, SeverityWarn\n\tcase \"block\":\n\t\treturn true, SeverityBlock\n\tdefault:\n\t\treturn true, SeverityWarn\n\t}\n}",
            "new_text": "\tswitch mode {\n\tcase \"off\", \"disabled\", \"none\":\n\t\treturn SeverityWarn\n\tcase \"block\":\n\t\treturn SeverityBlock\n\tdefault:\n\t\treturn SeverityWarn\n\t}\n}"
          }
        ]
